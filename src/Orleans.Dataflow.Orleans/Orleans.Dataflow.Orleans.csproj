<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Orleans hosting for Orleans.Dataflow: coordinator and run grains, the silo registration surface, and the remote run handle.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <!--
      The stream adapters need the provider abstractions and the stream implementation types; Server is
      Runtime plus Persistence.Memory plus Sdk plus Core and deliberately carries no Streaming.
    -->
    <PackageReference Include="Microsoft.Orleans.Streaming" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Orleans.Dataflow/Orleans.Dataflow.csproj" />
  </ItemGroup>
</Project>
