<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Directory.Build.props pins the C# language version, which is not a valid F# one. -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="AuthoringParityTests.fs" />
    <Compile Include="MaterializationTests.fs" />
    <Compile Include="OperatorParityTests.fs" />
    <Compile Include="OperatorBehaviorTests.fs" />
    <Compile Include="TimingBehaviorTests.fs" />
    <Compile Include="JunctionParityTests.fs" />
    <Compile Include="JunctionBehaviorTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <ProjectReference Include="../../src/Orleans.Dataflow.FSharp/Orleans.Dataflow.FSharp.fsproj" />
    <ProjectReference Include="../../src/Orleans.Dataflow/Orleans.Dataflow.csproj" />
    <ProjectReference Include="../../src/Orleans.Dataflow.Testing/Orleans.Dataflow.Testing.csproj" />
  </ItemGroup>
</Project>
